        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;rounded=0;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;ManiSkill + OpenVLA-OFT PPO: Parameter-Efficient RL&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="500" x="450" y="10" as="geometry" />
        </mxCell>
        <mxCell id="policy_block" parent="1" style="swimlane;startSize=22;html=1;fontStyle=1;container=0;rounded=0;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="Policy (OpenVLA-OFT 7B)" vertex="1">
