<mxfile host="Electron" agent="RLinf-on-EKS">
  <diagram name="OpenVLA-OFT PPO" id="openvlaoft-ppo">
    <mxGraphModel dx="1414" dy="912" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="700" math="0" shadow="0">
