        <mxCell id="llm" parent="policy_block" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;Llama 2 (7B) + LoRA Adapters&lt;/b&gt;&lt;br&gt;&lt;br&gt;Optimized Fine-Tuning (OFT):&lt;br&gt;LoRA rank-32 on LLM layers&lt;br&gt;Only LoRA params trained during RL&lt;br&gt;&lt;br&gt;Preserves pre-trained features&lt;br&gt;while enabling task adaptation" vertex="1">
