        <mxCell id="sim_gpu" parent="sim_block" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;GPU-Accelerated Physics&lt;/b&gt;&lt;br&gt;SAPIEN / MuJoCo backend&lt;br&gt;Parallel vectorized envs" vertex="1">
