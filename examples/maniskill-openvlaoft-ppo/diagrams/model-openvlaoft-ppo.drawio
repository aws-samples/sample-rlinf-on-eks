          <mxGeometry height="80" width="240" x="20" y="180" as="geometry" />
        </mxCell>
        <mxCell id="value_fn" parent="ppo_block" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;Value Function Loss&lt;/b&gt;&lt;br&gt;L_vf = (V(s) - R_target)²" vertex="1">
          <mxGeometry height="45" width="240" x="20" y="268" as="geometry" />
        </mxCell>
        <mxCell id="e_buf_gae" edge="1" parent="ppo_block" source="buffer" style="rounded=0;html=1;strokeWidth=2;labelBackgroundColor=none;fontColor=default;sketch=1;curveFitting=1;jiggle=2;" target="gae">
