          <mxGeometry height="60" width="240" x="20" y="30" as="geometry" />
        </mxCell>
        <mxCell id="gae" parent="ppo_block" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;GAE Advantage Estimation&lt;/b&gt;&lt;br&gt;A(t) = Σ (γλ)^k · δ(t+k)" vertex="1">
          <mxGeometry height="50" width="240" x="20" y="110" as="geometry" />
        </mxCell>
