        <mxCell id="e_ppo_policy" edge="1" parent="1" source="clip" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;labelBackgroundColor=none;fontColor=default;sketch=1;curveFitting=1;jiggle=2;" target="llm" value="&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;∇LoRA (adapter gradients only)&lt;/span&gt;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="900" y="280" />
              <mxPoint x="900" y="450" />
              <mxPoint x="140" y="450" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note_oft" parent="1" style="text;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;rounded=0;fontSize=11;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;Key Difference: Optimized Fine-Tuning (OFT) Recipe&lt;/b&gt;&lt;br&gt;- Pre-trained backbone weights are frozen during RL&lt;br&gt;- LoRA (rank-32) adapters on LLM layers are trainable&lt;br&gt;- MLP action head: continuous L1 regression output&lt;br&gt;- Parallel decoding with action chunking (8 steps)&lt;br&gt;- No discrete tokenization (unlike base OpenVLA)&lt;br&gt;- Much fewer trainable params than full fine-tuning&lt;br&gt;&lt;br&gt;&lt;b&gt;SFT checkpoint:&lt;/b&gt; openvla-oft-sft-libero10&lt;br&gt;(pre-trained on LIBERO-10, transferred to ManiSkill via LoRA adapter)" vertex="1">
          <mxGeometry height="150" width="350" x="40" y="470" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
