        <mxCell id="task" parent="sim_block" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;Task: Pick Cube&lt;/b&gt;&lt;br&gt;obs: RGB image + proprioception&lt;br&gt;action: 7-DoF end-effector delta&lt;br&gt;reward: dense (reaching + grasping)" vertex="1">
