        <mxCell id="e_cond_dit" edge="1" parent="wan_block" source="cond" style="rounded=0;html=1;strokeWidth=2;labelBackgroundColor=none;fontColor=default;sketch=1;curveFitting=1;jiggle=2;" target="dit">
