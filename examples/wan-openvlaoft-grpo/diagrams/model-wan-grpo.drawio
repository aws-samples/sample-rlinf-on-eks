            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_wan_grpo" edge="1" parent="1" source="imagined" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;labelBackgroundColor=none;fontColor=default;sketch=1;curveFitting=1;jiggle=2;" target="group" value="&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;(obs, action, reward) x8&lt;/span&gt;">
          <mxGeometry relative="1" x="0.087" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="910" y="420" />
              <mxPoint x="910" y="120" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_grpo_policy" edge="1" parent="1" source="clip" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;labelBackgroundColor=none;fontColor=default;sketch=1;curveFitting=1;jiggle=2;" target="llm" value="&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;∇ policy update&lt;/span&gt;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1110" y="490" />
              <mxPoint x="140" y="490" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note_wan" parent="1" style="text;html=1;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;rounded=0;fontSize=11;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;Key Idea: the environment is a learned video world model&lt;/b&gt;&lt;br&gt;- No physics simulator and no real robot in the training loop&lt;br&gt;- Wan generates &quot;imagined&quot; future frames from (obs, action, prompt)&lt;br&gt;- Reward is a world-model classifier (resnet_rm.pth) in [0, 1]&lt;br&gt;- No reset(): init frames bundled in the Wan checkpoint&lt;br&gt;- GRPO drops the critic — advantages are group-relative&lt;br&gt;- All components colocated on 1 node (8x H200)&lt;br&gt;&lt;br&gt;&lt;b&gt;Accuracy is measured separately in the real LIBERO simulator.&lt;/b&gt;" vertex="1">
          <mxGeometry height="160" width="380" x="104" y="530" as="geometry" />
        </mxCell>
        <mxCell id="detok" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;MLP Action Head&lt;/b&gt;&lt;br&gt;L1 regression → continuous 7-DoF actions" vertex="1">
          <mxGeometry height="45" width="185" x="161.5" y="390" as="geometry" />
        </mxCell>
        <mxCell id="e_llm_detok" edge="1" parent="1" source="llm" style="rounded=0;html=1;strokeWidth=2;labelBackgroundColor=none;fontColor=default;sketch=1;curveFitting=1;jiggle=2;" target="detok">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
