        </mxCell>
        <mxCell id="e_dit_rm" edge="1" parent="wan_block" source="dit" style="rounded=0;html=1;strokeWidth=2;labelBackgroundColor=none;fontColor=default;sketch=1;curveFitting=1;jiggle=2;" target="rm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_rm_img" edge="1" parent="wan_block" source="rm" style="rounded=0;html=1;strokeWidth=2;labelBackgroundColor=none;fontColor=default;sketch=1;curveFitting=1;jiggle=2;" target="imagined">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="grpo_block" parent="1" style="swimlane;startSize=22;html=1;fontStyle=1;container=0;rounded=0;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="GRPO Algorithm (no critic)" vertex="1">
          <mxGeometry height="320" width="280" x="970" y="60" as="geometry" />
        </mxCell>
        <mxCell id="group" parent="grpo_block" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;Group of Rollouts&lt;/b&gt;&lt;br&gt;group_size = 8 per prompt&lt;br&gt;sampled from the world model" vertex="1">
          <mxGeometry height="60" width="240" x="20" y="30" as="geometry" />
        </mxCell>
        <mxCell id="adv" parent="grpo_block" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;Group-Relative Advantage&lt;/b&gt;&lt;br&gt;A_i = (r_i − mean(group)) / std(group)&lt;br&gt;no value network" vertex="1">
          <mxGeometry height="60" width="240" x="20" y="120" as="geometry" />
        </mxCell>
        <mxCell id="clip" parent="grpo_block" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;Clipped GRPO Surrogate Loss&lt;/b&gt;&lt;br&gt;L = min(r·A, clip(r, 1±ε)·A)&lt;br&gt;&lt;br&gt;&lt;b&gt;Gradients update the OpenVLA-OFT policy&lt;/b&gt;" vertex="1">
          <mxGeometry height="90" width="240" x="20" y="210" as="geometry" />
        </mxCell>
        <mxCell id="e_grp_adv" edge="1" parent="grpo_block" source="group" style="rounded=0;html=1;strokeWidth=2;labelBackgroundColor=none;fontColor=default;sketch=1;curveFitting=1;jiggle=2;" target="adv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_adv_clip" edge="1" parent="grpo_block" source="adv" style="rounded=0;html=1;strokeWidth=2;labelBackgroundColor=none;fontColor=default;sketch=1;curveFitting=1;jiggle=2;" target="clip">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_policy_wan" edge="1" parent="1" source="detok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;labelBackgroundColor=none;fontColor=default;sketch=1;curveFitting=1;jiggle=2;" target="cond" value="&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;continuous&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;actions (7-DoF)&lt;/span&gt;&lt;/div&gt;">
          <mxGeometry relative="1" x="-0.0127" y="10" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
