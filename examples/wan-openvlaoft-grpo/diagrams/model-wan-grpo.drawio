        </mxCell>
        <mxCell id="rm" parent="wan_block" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;Reward Model (resnet_rm.pth)&lt;/b&gt;&lt;br&gt;scores imagined rollout&lt;br&gt;reward ∈ [0, 1]" vertex="1">
