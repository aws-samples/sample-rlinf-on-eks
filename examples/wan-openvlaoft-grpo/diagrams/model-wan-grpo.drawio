        </mxCell>
        <mxCell id="cond" parent="wan_block" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;Conditioning&lt;/b&gt;&lt;br&gt;current obs frame + 7-D action seq&lt;br&gt;+ task-language prompt&lt;br&gt;(init frames bundled in checkpoint — no reset())" vertex="1">
