        </mxCell>
        <mxCell id="policy_block" parent="1" style="swimlane;startSize=22;html=1;fontStyle=1;container=0;rounded=0;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="Policy (OpenVLA-OFT 7B)" vertex="1">
