        <mxCell id="vit" parent="policy_block" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;DINOv2 + SigLIP (Fused)&lt;/b&gt;&lt;br&gt;(Vision Encoder)&lt;br&gt;256x256 RGB → patches" vertex="1">
