        <mxCell id="imagined" parent="wan_block" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;&quot;Imagined&quot; rollout&lt;/b&gt;&lt;br&gt;(obs, action, reward) — no real robot" vertex="1">
