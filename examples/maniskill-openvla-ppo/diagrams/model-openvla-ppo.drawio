        <mxCell id="gae" parent="ppo_block" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;GAE Advantage Estimation&lt;/b&gt;&lt;br&gt;A(t) = Σ (γλ)^k · δ(t+k)&lt;br&gt;Generalized advantage estimator" vertex="1">
