        </mxCell>
        <mxCell id="value_fn" parent="ppo_block" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;" value="&lt;b&gt;Value Function Loss&lt;/b&gt;&lt;br&gt;L_vf = (V(s) - R_target)²" vertex="1">
